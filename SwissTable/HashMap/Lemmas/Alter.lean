    (modify m k f)[k] = f m[k] := by
  simp_to_model [modify, getElem] using List.Const.getValue_modifyKey_self

@[grind =]
theorem getElem!_modify [EquivBEq α] [LawfulHashable α] {k k' : α} [Inhabited β] {f : β → β} :
