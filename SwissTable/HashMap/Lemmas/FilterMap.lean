section map

variable {m : HashMap α β}

theorem map_id_equiv : m.map (fun _ v => v) ~m m := by
  simp_to_model [map, Equiv] using List.Perm.of_eq (List.map_id _)

theorem map_map_equiv {f : α → β → γ} {g : α → γ → δ} :
    (m.map f).map g ~m m.map fun k v => g k (f k v) := by
  simp_to_model [map, Equiv, toList] using List.Perm.of_eq (List.map_map)

theorem toList_map {f : α → β → γ} :
    (m.map f).toList.Perm (m.toList.map (fun p => (p.1, f p.1 p.2))) := by
  simp_to_model [map, Const.toList]
  simp only [List.map_map, Function.comp_def]
  rfl

theorem keys_map {f : α → β → γ} : (m.map f).keys.Perm m.keys := by
  simp_to_model [keys, map, Equiv]
  rw [List.keys_map]

theorem filterMap_equiv_map [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} :
    (m.filterMap (fun k v => some (f k v))) ~m m.map f := by
  simp_to_model [Equiv, filterMap, map] using List.Perm.of_eq (congrFun List.filterMap_eq_map' _)

@[simp, grind =, cbv_eval]
theorem isEmpty_map [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} :
    (m.map f).isEmpty = m.isEmpty := by
  simp_to_model [map, isEmpty] using List.isEmpty_map

@[simp, grind =, cbv_eval]
theorem contains_map [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} {k : α} :
    (m.map f).contains k = m.contains k := by
  simp_to_model [map, contains, mem] using List.containsKey_map

theorem contains_of_contains_map [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} {k : α} :
    (m.map f).contains k = true → m.contains k = true := by
  simp [contains_map]

@[simp, grind =]
theorem mem_map [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} {k : α} :
    k ∈ m.map f ↔ k ∈ m := by
  simp only [mem_iff_contains, contains_map]

theorem mem_of_mem_map [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} {k : α} :
    k ∈ m.map f → k ∈ m := by
  simp

@[simp, grind =, cbv_eval]
theorem size_map [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} :
    (m.map f).size = m.size := by
  simp_to_model [map, size] using List.length_map

@[simp, grind =, cbv_eval]
theorem getElem?_map [LawfulBEq α]
    {f : α → β → γ} {k : α} :
    (m.map f)[k]? = m[k]?.map (f k) := by
  simp_to_model [map, getElem?]
  rw [Const.getValue?_map (Model.distinctKeys m)]
  simp [Std.Internal.List.getKey_eq]

/-- Variant of `getElem?_map` that holds with `EquivBEq` (i.e. without `LawfulBEq`). -/
@[simp (low)]
theorem getElem?_map' [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} {k : α} :
    (m.map f)[k]? = m[k]?.pmap (fun v h' => f (m.getKey k h') v)
      (fun _ h' => mem_iff_isSome_getElem?.mpr (Option.isSome_of_eq_some h')) := by
  simp_to_model [map, getElem?, contains, mem, getKey] using Const.getValue?_map

theorem getElem?_map_of_getKey?_eq_some [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} {k k' : α} (h : m.getKey? k = some k') :
    (m.map f)[k]? = m[k]?.map (f k') := by
  simp_to_model [map, getElem?, getKey?] at * using Const.getValue?_map_of_getKey?_eq_some

@[simp, grind =]
theorem getElem_map [LawfulBEq α]
    {f : α → β → γ} {k : α} {h'} :
    (m.map f)[k]'(h') =
      f k (m[k]'(mem_of_mem_map h')) := by
  simp_to_model [map, getElem, contains, mem]
  rw [getValue_map (Model.distinctKeys m)]
  simp [Std.Internal.List.getKey_eq]

/-- Variant of `getElem_map` that holds with `EquivBEq` (i.e. without `LawfulBEq`). -/
@[simp (low)]
theorem getElem_map' [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} {k : α} {h'} :
    (m.map f)[k]'(h') =
      f (m.getKey k (mem_of_mem_map h')) (m[k]'(mem_of_mem_map h')) := by
  simp_to_model [map, getKey, getElem, contains, mem] using List.getValue_map

@[grind =, cbv_eval]
theorem getElem!_map [LawfulBEq α] [Inhabited γ]
    {f : α → β → γ} {k : α} :
    (m.map f)[k]! =
      (m[k]?.map (f k)).get! := by
  simp [getElem!_eq_get!_getElem?, getElem?_map]

/-- Variant of `getElem!_map` that holds with `EquivBEq` (i.e. without `LawfulBEq`). -/
theorem getElem!_map' [EquivBEq α] [LawfulHashable α] [Inhabited γ]
    {f : α → β → γ} {k : α} :
    (m.map f)[k]! =
      (m[k]?.pmap (fun v h => f (m.getKey k h) v)
        (fun _ h' => mem_iff_isSome_getElem?.mpr (Option.isSome_of_mem h'))).get! := by
  simp_to_model [map, getKey, getElem!, getElem?, contains, mem] using List.Const.getValue!_map

theorem getElem!_map_of_getKey?_eq_some [EquivBEq α] [LawfulHashable α] [Inhabited γ]
    {f : α → β → γ} {k k' : α} (h : m.getKey? k = some k') :
    (m.map f)[k]! = (m[k]?.map (f k')).get! := by
  simp_to_model [map, getElem!, getElem?, getKey?] at * using Const.getValue!_map_of_getKey?_eq_some

@[grind =, cbv_eval]
theorem getD_map [LawfulBEq α]
    {f : α → β → γ} {k : α} {fallback : γ} :
    (m.map f).getD k fallback =
      (m[k]?.map (f k)).getD fallback := by
  simp [getD_eq_getD_getElem?, getElem?_map]

/-- Variant of `getD_map` that holds with `EquivBEq` (i.e. without `LawfulBEq`). -/
theorem getD_map' [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} {k : α} {fallback : γ} :
    (m.map f).getD k fallback =
      (m[k]?.pmap (fun v h => f (m.getKey k h) v)
        (fun _ h' => mem_iff_isSome_getElem?.mpr (Option.isSome_of_eq_some h'))).getD fallback := by
  simp_to_model [map, getKey, getD, getElem?, contains, mem] using List.Const.getValueD_map

theorem getD_map_of_getKey?_eq_some [EquivBEq α] [LawfulHashable α] [Inhabited γ]
    {f : α → β → γ} {k k' : α} {fallback : γ} (h : m.getKey? k = some k') :
    (m.map f).getD k fallback = (m[k]?.map (f k')).getD fallback := by
  simp_to_model [map, getD, getElem?, getKey?] at * using Const.getValueD_map_of_getKey?_eq_some

@[simp, grind =, cbv_eval]
theorem getKey?_map [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} {k : α} :
    (m.map f).getKey? k = m.getKey? k := by
  simp_to_model [map, getKey?] using List.getKey?_map

@[simp, grind =]
theorem getKey_map [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} {k : α} {h'} :
    (m.map f).getKey k h' = m.getKey k (mem_of_mem_map h') := by
  simp_to_model [map, getKey] using List.getKey_map

@[simp, grind =, cbv_eval]
theorem getKey!_map [EquivBEq α] [LawfulHashable α] [Inhabited α]
    {f : α → β → γ} {k : α} :
    (m.map f).getKey! k = m.getKey! k := by
  simp_to_model [map, getKey!] using List.getKey!_map

@[simp, grind =, cbv_eval]
theorem getKeyD_map [EquivBEq α] [LawfulHashable α]
    {f : α → β → γ} {k fallback : α} :
    (m.map f).getKeyD k fallback = m.getKeyD k fallback := by
  simp_to_model [map, getKeyD] using List.getKeyD_map

end map

