section filter

variable {m : HashMap α β}

theorem filterMap_equiv_filter {f : α → β → Bool} :
    (m.filterMap (fun k => Option.guard (fun v => f k v))) ~m m.filter f := by
  simp_to_model [Equiv, filterMap, filter]
  rw [← List.filterMap_eq_filter]
  apply List.Perm.of_eq
  congr
  funext p
  simp only [Option.guard]
  split <;> rfl

theorem toList_filter {f : α → β → Bool} :
    (m.filter f).toList.Perm (m.toList.filter (fun p => f p.1 p.2)) := by
  simp_to_model [filter, Const.toList]
  simp only [List.filter_map, Function.comp_def]
  rfl

theorem keys_filter_key {f : α → Bool} :
    (m.filter fun k _ => f k).keys.Perm (m.keys.filter f) := by
  simp_to_model [keys, filter]
  simp only [List.keys_eq_map, List.filter_map, Function.comp_def, List.Perm.rfl]

