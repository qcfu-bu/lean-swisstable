variable {m : HashMap α β}

@[simp, grind =]
theorem length_keys [EquivBEq α] [LawfulHashable α] :
    m.keys.length = m.size := by
  simp_to_model [size, keys] using List.length_keys_eq_length

@[simp, grind =]
theorem isEmpty_keys [EquivBEq α] [LawfulHashable α]:
    m.keys.isEmpty = m.isEmpty := by
  simp_to_model [isEmpty, keys] using List.isEmpty_keys_eq_isEmpty

@[simp, grind =]
theorem contains_keys [EquivBEq α] [LawfulHashable α] {k : α} :
    m.keys.contains k = m.contains k := by
  simp_to_model [contains, mem, keys] using List.containsKey_eq_keys_contains.symm

@[simp, grind =]
theorem mem_keys [LawfulBEq α] {k : α} :
    k ∈ m.keys ↔ k ∈ m := by
  rw [← List.contains_iff_mem]
  simp_to_model [contains, mem, keys]
  rw [List.containsKey_eq_keys_contains]

theorem mem_of_mem_keys [EquivBEq α] [LawfulHashable α] {k : α} (h : k ∈ m.keys) : k ∈ m :=
  (contains_keys).symm.trans (List.elem_eq_true_of_mem h)

theorem distinct_keys [EquivBEq α] [LawfulHashable α] :
    m.keys.Pairwise (fun a b => (a == b) = false) := by
  simp_to_model [keys] using (Model.distinctKeys m).distinct

theorem nodup_keys [EquivBEq α] [LawfulHashable α] :
    m.keys.Nodup :=
  m.distinct_keys.imp ne_of_beq_false

@[simp]
theorem toArray_keys :
    m.keys.toArray = m.keysArray := by
  simp_to_model

@[simp]
theorem toList_keysArray :
    m.keysArray.toList = m.keys := by
  simp_to_model

@[simp]
theorem size_keysArray [EquivBEq α] [LawfulHashable α] :
    m.keysArray.size = m.size := by
  simp [← toArray_keys]

@[simp]
theorem isEmpty_keysArray [EquivBEq α] [LawfulHashable α] :
    m.keysArray.isEmpty = m.isEmpty := by
  simp [← toArray_keys]

@[simp]
theorem contains_keysArray [EquivBEq α] [LawfulHashable α]
    {k : α} :
    m.keysArray.contains k = m.contains k := by
  simp [← toArray_keys]

@[simp]
theorem mem_keysArray [LawfulBEq α] {k : α} :
    k ∈ m.keysArray ↔ k ∈ m := by
  simp [← toArray_keys]

theorem forall_mem_keysArray_iff_forall_mem_getKey [EquivBEq α] [LawfulHashable α]
    {p : α → Prop} :
    (∀ k ∈ m.keysArray, p k) ↔ ∀ (k : α) (h : k ∈ m), p (m.getKey k h) := by
  simp only [← toArray_keys, List.mem_toArray]
  simp_to_model [keys, getKey, mem] using List.forall_mem_keys_iff_forall_containsKey_getKey

theorem contains_of_mem_keysArray [EquivBEq α] [LawfulHashable α] {k : α}
    (h' : k ∈ m.keysArray) : m.contains k :=
  (contains_keysArray).symm.trans (Array.contains_eq_true_of_mem h')

@[simp, grind _=_]
theorem map_fst_toList_eq_keys [EquivBEq α] [LawfulHashable α] :
    m.toList.map Prod.fst = m.keys := by
  simp_to_model [keys, toList] using List.map_fst_map_toProd_eq_keys

@[simp, grind =]
theorem length_toList [EquivBEq α] [LawfulHashable α] :
    m.toList.length = m.size := by
  simp_to_model [size, toList] using List.length_map

@[simp, grind =]
theorem isEmpty_toList [EquivBEq α] [LawfulHashable α] :
    m.toList.isEmpty = m.isEmpty := by
  simp_to_model [isEmpty, toList]
  rw [Bool.eq_iff_iff, List.isEmpty_iff,List.isEmpty_iff, List.map_eq_nil_iff]

@[simp, grind =]
theorem mem_toList_iff_getElem?_eq_some [LawfulBEq α]
    {k : α} {v : β} :
    (k, v) ∈ m.toList ↔ m[k]? = some v := by
  simp_to_model [toList, getElem?] using List.mem_map_toProd_iff_getValue?_eq_some

@[simp]
theorem mem_toList_iff_getKey?_eq_some_and_getElem?_eq_some [EquivBEq α] [LawfulHashable α]
    {k : α} {v : β} :
    (k, v) ∈ m.toList ↔ m.getKey? k = some k ∧ m[k]? = some v := by
  simp_to_model [toList, getKey?, getElem?] using List.mem_map_toProd_iff_getKey?_eq_some_and_getValue?_eq_some

theorem getElem?_eq_some_iff_exists_beq_and_mem_toList [EquivBEq α] [LawfulHashable α]
    {k : α} {v : β} :
    m[k]? = some v ↔ ∃ (k' : α), k == k' ∧ (k', v) ∈ m.toList := by
  simp_to_model [getElem?, toList] using getValue?_eq_some_iff_exists_beq_and_mem_toList

theorem find?_toList_eq_some_iff_getKey?_eq_some_and_getElem?_eq_some
    [EquivBEq α] [LawfulHashable α] {k k' : α} {v : β} :
    m.toList.find? (fun a => a.1 == k) = some ⟨k', v⟩ ↔
      m.getKey? k = some k' ∧ m[k]? = some v := by
  simp_to_model [getKey?, getElem?, toList] using List.find?_map_toProd_eq_some_iff_getKey?_eq_some_and_getValue?_eq_some

theorem find?_toList_eq_none_iff_contains_eq_false [EquivBEq α] [LawfulHashable α]
    {k : α} :
    m.toList.find? (·.1 == k) = none ↔ m.contains k = false := by
  simp_to_model [toList, contains, mem] using List.find?_map_eq_none_iff_containsKey_eq_false

@[simp]
theorem find?_toList_eq_none_iff_not_mem [EquivBEq α] [LawfulHashable α]
    {k : α} :
    m.toList.find? (·.1 == k) = none ↔ ¬ k ∈ m := by
  simp_to_model [toList, contains, mem] using List.find?_map_eq_none_iff_containsKey_eq_false

theorem distinct_keys_toList [EquivBEq α] [LawfulHashable α] :
    m.toList.Pairwise (fun a b => (a.1 == b.1) = false) := by
  simp_to_model [toList] using List.pairwise_fst_eq_false_map_toProd

@[simp]
theorem toArray_toList :
    m.toList.toArray = m.toArray := by
  simp_to_model

@[simp]
theorem toList_toArray :
    m.toArray.toList = m.toList := by
  simp_to_model

@[simp]
theorem map_fst_toArray_eq_keysArray [EquivBEq α] [LawfulHashable α] :
    m.toArray.map Prod.fst = m.keysArray := by
  simp [← toArray_toList, List.map_toArray, ← toArray_keys, map_fst_toList_eq_keys]

@[simp]
theorem size_toArray [EquivBEq α] [LawfulHashable α] :
    m.toArray.size = m.size := by
  simp [← toArray_toList, length_toList]

@[simp]
theorem isEmpty_toArray [EquivBEq α] [LawfulHashable α] :
    m.toArray.isEmpty = m.isEmpty := by
  simp [← toArray_toList, isEmpty_toList]

theorem mem_toArray_iff_getElem?_eq_some [LawfulBEq α]
    {k : α} {v : β} :
    (k, v) ∈ m.toArray ↔ m[k]? = some v := by
  simp [← toArray_toList, mem_toList_iff_getElem?_eq_some]

theorem getElem?_eq_some_iff_exists_beq_and_mem_toArray [EquivBEq α] [LawfulHashable α]
    {k : α} {v : β} :
    m[k]? = some v ↔ ∃ (k' : α), k == k' ∧ (k', v) ∈ m.toArray := by
  rw [getElem?_eq_some_iff_exists_beq_and_mem_toList, ← toArray_toList]
  simp only [List.mem_toArray]

theorem find?_toArray_eq_some_iff_getKey?_eq_some_and_getElem?_eq_some
    [EquivBEq α] [LawfulHashable α] {k k' : α} {v : β} :
    m.toArray.find? (fun a => a.1 == k) = some ⟨k', v⟩ ↔
      m.getKey? k = some k' ∧ m[k]? = some v := by
  simp [← toArray_toList, List.find?_toArray, find?_toList_eq_some_iff_getKey?_eq_some_and_getElem?_eq_some]

theorem find?_toArray_eq_none_iff_contains_eq_false [EquivBEq α] [LawfulHashable α]
    {k : α} :
    m.toArray.find? (·.1 == k) = none ↔ m.contains k = false := by
  simp only [← toArray_toList, List.find?_toArray, find?_toList_eq_none_iff_contains_eq_false]

theorem mem_toArray_iff_getKey?_eq_some_and_getElem?_eq_some [EquivBEq α] [LawfulHashable α]
    {k: α} {v : β} :
    (k, v) ∈ m.toArray ↔ m.getKey? k = some k ∧ m[k]? = some v := by
  simp [← toArray_toList, mem_toList_iff_getKey?_eq_some_and_getElem?_eq_some]

section monadic

variable {m : HashMap α β} {δ : Type w} {m' : Type w → Type w'}

theorem foldM_eq_foldlM_toList [Monad m'] [LawfulMonad m']
    {f : δ → (a : α) → β → m' δ} {init : δ} :
    m.foldM f init = m.toList.foldlM (fun a b => f a b.1 b.2) init := by
  simp_to_model [foldM, toList] using List.foldlM_eq_foldlM_toProd

theorem fold_eq_foldl_toList {f : δ → (a : α) → β → δ} {init : δ} :
    m.fold f init = m.toList.foldl (fun a b => f a b.1 b.2) init := by
  simp_to_model [fold, toList] using List.foldl_eq_foldl_toProd

@[simp, grind =]
theorem forM_eq_forM [Monad m'] [LawfulMonad m'] {f : (a : α) → β → m' PUnit} :
    m.forM f = ForM.forM m (fun a => f a.1 a.2) :=
  rfl

theorem forM_eq_forM_toList [Monad m'] [LawfulMonad m'] {f : α × β → m' PUnit} :
    ForM.forM m f = ForM.forM m.toList f := by
  show m.forM (fun a b => f (a, b)) = m.toList.forM f
  rw [Model.forM_eq_forM_toListModel, Model.toList_eq_toListModel_map]
  exact List.forM_eq_forM_toProd (m' := m') (l := Model.toListModel m) (f := fun a b => f (a, b))

@[simp, grind =]
theorem forIn_eq_forIn [Monad m'] [LawfulMonad m']
    {f : (a : α) → β → δ → m' (ForInStep δ)} {init : δ} :
    m.forIn f init = ForIn.forIn m init (fun a d => f a.1 a.2 d) :=
  rfl

theorem forIn_eq_forIn_toList [Monad m'] [LawfulMonad m']
    {f : α × β → δ → m' (ForInStep δ)} {init : δ} :
    ForIn.forIn m init f = ForIn.forIn m.toList init f := by
  show m.forIn (fun a b acc => f (a, b) acc) init = ForIn.forIn m.toList init f
  rw [Model.forIn_eq_forIn_toListModel, Model.toList_eq_toListModel_map]
  exact List.forIn_eq_forIn_toProd (m' := m') (l := Model.toListModel m)
    (f := fun a b d => f (a, b) d)

@[simp, grind =]
theorem forIn_toList (c : HashMap α β) : ForIn.toList c = c.toList :=
  Std.Internal.ForIn.toList_eq_of_forIn_eq fun _ _ => forIn_eq_forIn_toList

instance [Monad m'] [LawfulMonad m'] :
    Std.Internal.PureForIn m' (HashMap α β) (α × β) where
  forIn_eq _ _ _ := by rw [forIn_toList]; exact forIn_eq_forIn_toList

theorem foldM_eq_foldlM_keys [Monad m'] [LawfulMonad m']
    {f : δ → α → m' δ} {init : δ} :
    m.foldM (fun d a _ => f d a) init = m.keys.foldlM f init := by
  simp_to_model [foldM, keys] using List.foldlM_eq_foldlM_keys

theorem fold_eq_foldl_keys {f : δ → α → δ} {init : δ} :
    m.fold (fun d a _ => f d a) init = m.keys.foldl f init := by
  simp_to_model [fold, keys] using List.foldl_eq_foldl_keys

theorem forM_eq_forM_keys [Monad m'] [LawfulMonad m'] {f : α → m' PUnit} :
    ForM.forM m (fun a => f a.1) = m.keys.forM f := by
  show m.forM (fun a _ => f a) = m.keys.forM f
  rw [Model.forM_eq_forM_toListModel, Model.keys_eq_keys_toListModel]
  exact List.forM_eq_forM_keys (m' := m')

theorem forIn_eq_forIn_keys [Monad m'] [LawfulMonad m']
    {f : α → δ → m' (ForInStep δ)} {init : δ} :
    ForIn.forIn m init (fun a d => f a.1 d) = ForIn.forIn m.keys init f := by
  show m.forIn (fun a _ d => f a d) init = ForIn.forIn m.keys init f
  rw [Model.forIn_eq_forIn_toListModel, Model.keys_eq_keys_toListModel]
  exact List.forIn_eq_forIn_keys (m' := m')

theorem foldM_eq_foldlM_toArray [Monad m'] [LawfulMonad m']
    {f : δ → α → β → m' δ} {init : δ} :
    m.foldM f init = m.toArray.foldlM (fun a b => f a b.1 b.2) init := by
  simp [← toArray_toList, foldM_eq_foldlM_toList]

theorem fold_eq_foldl_toArray {f : δ → α → β → δ} {init : δ} :
    m.fold f init = m.toArray.foldl (fun a b => f a b.1 b.2) init := by
  simp [← toArray_toList, fold_eq_foldl_toList]

theorem forM_eq_forM_toArray [Monad m'] [LawfulMonad m'] {f : α → β → m' PUnit} :
    m.forM f = m.toArray.forM (fun a => f a.1 a.2) := by
  rw [← toArray_toList, List.forM_toArray' _ _ rfl, forM_eq_forM, forM_eq_forM_toList]
  rfl

theorem forIn_eq_forIn_toArray [Monad m'] [LawfulMonad m']
    {f : α → β → δ → m' (ForInStep δ)} {init : δ} :
    m.forIn f init = ForIn.forIn m.toArray init (fun a b => f a.1 a.2 b) := by
  simp [← toArray_toList, forIn_eq_forIn_toList]

theorem foldM_eq_foldlM_keysArray [Monad m'] [LawfulMonad m']
    {f : δ → α → m' δ} {init : δ} :
    m.foldM (fun d a _ => f d a) init = m.keysArray.foldlM f init := by
  simp [← toArray_keys, foldM_eq_foldlM_keys]

theorem fold_eq_foldl_keysArray {f : δ → α → δ} {init : δ} :
    m.fold (fun d a _ => f d a) init = m.keysArray.foldl f init := by
  simp [← toArray_keys, fold_eq_foldl_keys]

theorem forM_eq_forM_keysArray [Monad m'] [LawfulMonad m'] {f : α → m' PUnit} :
    m.forM (fun a _ => f a) = m.keysArray.forM f := by
  rw [← toArray_keys, List.forM_toArray' _ _ rfl, forM_eq_forM, forM_eq_forM_keys]

theorem forIn_eq_forIn_keysArray [Monad m'] [LawfulMonad m']
    {f : α → δ → m' (ForInStep δ)} {init : δ} :
    m.forIn (fun a _ d => f a d) init = ForIn.forIn m.keysArray init f := by
  simp [← toArray_keys, forIn_eq_forIn_keys]

end monadic

theorem all_eq_not_any_not {p : (a : α) → β → Bool} :
    m.all p = ! m.any (fun a b => ! p a b) := by
  rw [Model.all_eq_all_toListModel, Model.any_eq_any_toListModel, List.all_eq_not_any_not]

theorem any_eq_not_all_not {p : (a : α) → β → Bool} :
    m.any p = ! m.all (fun a b => ! p a b) := by
  rw [Model.all_eq_all_toListModel, Model.any_eq_any_toListModel, List.any_eq_not_all_not]

@[simp]
theorem any_toList {p : α → β → Bool} :
    m.toList.any (fun x => p x.1 x.2) = m.any p := by
  rw [Model.toList_eq_toListModel_map, Model.any_eq_any_toListModel, List.any_map]
  rfl

theorem any_eq_true_iff_exists_mem_getKey_getElem [LawfulHashable α] [EquivBEq α]
    {p : α → β → Bool} :
    m.any p = true ↔ ∃ (a : α) (h : a ∈ m), p (m.getKey a h) (m[a]'h) := by
  simp only [← any_toList, List.any_eq_true, Prod.exists,
    mem_toList_iff_getKey?_eq_some_and_getElem?_eq_some, getElem?_eq_some_iff,
    getKey?_eq_some_iff]
  constructor
  · intro h'
    rcases h' with ⟨a, b, h', hp⟩
    rcases h' with ⟨ha, h₁, hb⟩
    rcases ha with ⟨h₂, ha⟩
    exists a
    exists h₁
    simp [ha, hb, hp]
  · intro h'
    rcases h' with ⟨a, h', hp⟩
    exists m.getKey a h'
    exists m[a]'h'
    simp only [hp, and_true]
    have ha : m.getKey a h' ∈ m := by
      apply mem_of_getKey?_eq_some
      rw [getKey?_eq_some_iff (k := a)]
      exists h'
    simp [ha, getKey_congr (getKey_beq h'), getElem_congr (getKey_beq h')]

theorem any_eq_true_iff_exists_mem_getElem [LawfulBEq α] {p : α → β → Bool} :
    m.any p = true ↔ ∃ (a : α) (h : a ∈ m), p a (m[a]'h) := by
  simp [any_eq_true_iff_exists_mem_getKey_getElem, getKey_eq]

theorem any_eq_false_iff_forall_mem_getKey_getElem [LawfulHashable α] [EquivBEq α]
    {p : α → β → Bool} :
    m.any p = false ↔
      ∀ (a : α) (h : a ∈ m), p (m.getKey a h) (m[a]'h) = false := by
  simp only [← any_toList, List.any_eq_false,
    mem_toList_iff_getKey?_eq_some_and_getElem?_eq_some, getKey?_eq_some_iff,
    getElem?_eq_some_iff, Bool.not_eq_true, and_imp, forall_exists_index, Prod.forall]
  constructor
  · intro h' k hk
    have hk' : m.contains (m.getKey k hk) := by
      apply mem_of_getKey?_eq_some
      rw [getKey?_eq_some_iff (k := k)]
      exists hk
    apply h' _ _ hk' _ hk' (getElem_congr (getKey_beq hk))
    apply getKey_congr (getKey_beq _)
  · intro h' a b ha ha' ha₂ hb
    rw [← ha', ← hb]
    apply h'

theorem any_eq_false_iff_forall_mem_getElem [LawfulBEq α] {p : α → β → Bool} :
    m.any p = false ↔
      ∀ (a : α) (h : a ∈ m), p a (m[a]'h) = false := by
  simp [any_eq_false_iff_forall_mem_getKey_getElem, getKey_eq]

@[simp]
theorem all_toList {p : α → β → Bool} :
    m.toList.all (fun x => p x.1 x.2) = m.all p := by
  rw [Model.toList_eq_toListModel_map, Model.all_eq_all_toListModel, List.all_map]
  rfl

theorem all_eq_true_iff_forall_mem_getKey_getElem [EquivBEq α] [LawfulHashable α]
    {p : (a : α) → β → Bool} :
    m.all p = true ↔ ∀ (a : α) (h : a ∈ m), p (m.getKey a h) (m[a]'h) := by
  simp [all_eq_not_any_not, any_eq_false_iff_forall_mem_getKey_getElem]

theorem all_eq_true_iff_forall_mem_getElem [LawfulBEq α] {p : α → β → Bool} :
    m.all p = true ↔ ∀ (a : α) (h : a ∈ m), p a (m[a]'h) := by
  simp [all_eq_true_iff_forall_mem_getKey_getElem, getKey_eq]

theorem all_eq_false_iff_exists_mem_getKey_getElem [EquivBEq α] [LawfulHashable α]
    {p : (a : α) → β → Bool} :
    m.all p = false ↔ ∃ (a : α) (h : a ∈ m), p (m.getKey a h) (m[a]'h) = false := by
  simp [all_eq_not_any_not, any_eq_true_iff_exists_mem_getKey_getElem]

theorem all_eq_false_iff_exists_mem_getElem [LawfulBEq α] {p : α → β → Bool} :
    m.all p = false ↔ ∃ (a : α) (h : a ∈ m), p a (m[a]'h) = false := by
  simp [all_eq_false_iff_exists_mem_getKey_getElem, getKey_eq]

theorem any_keys [LawfulHashable α] [EquivBEq α] {p : α → Bool} :
    m.keys.any p = m.any (fun a _ => p a) := by
  rw [Model.keys_eq_keys_toListModel, Model.any_eq_any_toListModel, List.keys_eq_map,
    List.any_map]
  rfl

theorem all_keys [LawfulHashable α] [EquivBEq α] {p : α → Bool} :
    m.keys.all p = m.all (fun a _ => p a) := by
  rw [Model.keys_eq_keys_toListModel, Model.all_eq_all_toListModel, List.keys_eq_map,
    List.all_map]
  rfl

end

end SwissTable.HashMap
