theorem getThenInsertIfNew?_fst {k : α} {v : β} : (getThenInsertIfNew? m k v).1 = m[k]? :=
  Core.Table.getThenInsertIfNew?_fst

@[simp, grind =]
theorem getThenInsertIfNew?_snd {k : α} {v : β} :
